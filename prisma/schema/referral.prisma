model AccountDeletionAudit {
  id               String   @id @default(uuid())
  originalUserId   String
  vendorId         String?
  name             String
  mobile           String?
  email            String?
  role             Role
  deletionType     String
  deletedByAdminId String?
  walletInfo       Json?
  refundClaimed    Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())

  @@index([mobile])
  @@index([email])
  @@index([originalUserId])
}
