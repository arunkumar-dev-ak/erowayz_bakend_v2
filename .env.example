# ==========================================
# 0. Application Server Configuration
# ==========================================
PORT=3000

# ==========================================
# 1. Database Configuration (Read by Docker Compose)
# ==========================================
DB_HOST=localhost
DB_PORT=5435
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=eroways

# ==========================================
# 2. Prisma Connection Strings
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/eroways?schema=public&connection_limit=10&pool_timeout=30"
DIRECT_URL="postgresql://postgres:postgres@localhost:5435/eroways?schema=public"

# ==========================================
# 3. Redis Configuration (Read by Docker & NestJS)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DATABASE=1

# ==========================================
# 4. Auth & Security Tokens
# ==========================================
ACCESS_TOKEN_VALIDITY='1d'
REFRESH_TOKEN_VALIDITY='30d'
REFRESH_TOKEN_LIMIT='10'
ACCESS_TOKEN_SECRET='AccessTokenSecret'
REFRESH_TOKEN_SECRET='RefreshTokenSecret'

SIGNUP_OTP_VALIDITY=300000
LOGIN_OTP_VALIDITY=300000

# ==========================================
# 5. Application Timers & Sockets
# ==========================================
BANNER_CREATION_AHEAD_TIME='1m'
BANNER_UPDATION_AHEAD_TIME='30s'
STREET_FOOD_BANNER_MAX_ITEMS=10
ORDER_EXPIRY_TIME='1m'
SOCKET_TTL=36000

# ==========================================
# 6. Bull Dashboard
# ==========================================
BULL_DASHBOARD_USERNAME=your_username
BULL_DASHBOARD_PASSWORD=your_pwd

# ==========================================
# 7. Payment Gateway (Juspay)
# ==========================================
JUSPAY_MERCHANT_ID=your_merchant_id
JUSPAY_APIKEY=your_api_key
SUBSCRIPTION_INITIATION_COUNT=2
ORDER_INITIATION_COUNT=2
MAX_PAYMENT_INITIATION_LIMT=5

# ==========================================
# 7b. Food Preferences
# ==========================================
MAX_FOOD_PREFERENCES_PER_ORDER=5

# ==========================================
# 7c. Vendor Stock Alerts
# ==========================================
STOCK_ALERT_LOW_THRESHOLD=5
STOCK_ALERT_STACK_LIMIT=3

# ==========================================
# 7d. Account Deletion & Anonymization
# ==========================================
ACCOUNT_DELETION_GRACE_DAYS=30

# ==========================================
# 8. WhatsApp Integration
# ==========================================
WHATSAPP_OTP_REQUEST=https://whatsapp.mybotify.com/api/otp/request
WHATSAPP_OTP_VERIFY=https://whatsapp.mybotify.com/api/otp/verify
WHATSAPP_SIGNATURE_HASH=yourhash_key
WHATSAPP_INTEGRATION_TOKEN=your_token

# ==========================================
# 9. HTTP Request Logging
# ==========================================
# Automatically enabled in development (when NODE_ENV is not 'production').
# Set to 'true' to explicitly enable one-line HTTP request logging in live/production.
ENABLE_HTTP_LOGS=false

